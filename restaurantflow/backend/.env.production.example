# RestaurantFlow Backend - Production Environment Configuration
# Set these in your hosting platform (Render / Railway / Fly.io / VPS)

NODE_ENV=production
PORT=5000

# Cloud PostgreSQL (Neon, Supabase, Render Postgres, AWS RDS)
DATABASE_URL=postgresql://postgres_user:strong_password@ep-cloud-instance.region.aws.neon.tech/restaurantflow?sslmode=require

# Cloud Redis (Upstash Redis, Redis Cloud, or local container)
REDIS_URL=redis://default:redis_password@redis-cloud-instance.upstash.io:6379

# Cryptographic Authentication Secrets (Replace with secure random 32+ char strings)
JWT_ACCESS_SECRET=production-jwt-access-secret-minimum-32-chars-key-prod-001!
JWT_REFRESH_SECRET=production-jwt-refresh-secret-minimum-32-chars-key-prod-001!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend Origin for CORS & WebSocket Security
FRONTEND_URL=https://restaurantflow.com

# Payment & Logging
PAYMENT_PROVIDER=mock
LOG_LEVEL=info
