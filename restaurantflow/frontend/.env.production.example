# RestaurantFlow Frontend - Production Environment Configuration
# Set these in your hosting platform (Vercel / Netlify / Render) dashboard

# 1. Option A: Split domain (e.g., frontend on restaurantflow.com, backend on api.restaurantflow.com)
VITE_API_URL=https://api.restaurantflow.com/api
VITE_SOCKET_URL=https://api.restaurantflow.com

# 2. Option B: Single domain / reverse proxy (if Nginx/Cloudflare routes /api directly to backend)
# VITE_API_URL=/api
# VITE_SOCKET_URL=https://restaurantflow.com
