# ==============================================================================
# RestaurantFlow Environment Configuration
# ==============================================================================

# Application Environment (development, production, test)
NODE_ENV=development

# Backend Server Port
PORT=5000

# PostgreSQL Connection String (Pure PostgreSQL + pg driver)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurantflow

# Redis URL (For caching, rate-limiting and temporary state - gracefully falls back if unavailable)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (Replace with strong random strings in production)
JWT_ACCESS_SECRET=development-access-secret-32-chars-minimum-key!
JWT_REFRESH_SECRET=development-refresh-secret-32-chars-minimum-key!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins
FRONTEND_URL=http://localhost:5173

# Payment Provider Setting (mock | razorpay | stripe)
PAYMENT_PROVIDER=mock

# App Log Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
