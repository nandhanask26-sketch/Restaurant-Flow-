# ==============================================================================
# RestaurantFlow Environment Configuration
# ==============================================================================

# Application Environment (development, production, test)
NODE_ENV=development

# Backend Server Port
PORT=5000

# PostgreSQL Connection String (Pure PostgreSQL + pg driver)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurantflow

# Redis URL (For caching, rate-limiting and temporary OTP storage - falls back to in-memory if offline)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (Replace with 32+ character random strings in production)
JWT_ACCESS_SECRET=development-access-secret-32-chars-minimum-key!
JWT_REFRESH_SECRET=development-refresh-secret-32-chars-minimum-key!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins
FRONTEND_URL=http://localhost:5173

# Payment Provider Setting (mock | razorpay | stripe)
PAYMENT_PROVIDER=mock

# App Log Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# ==============================================================================
# Google OAuth 2.0 / Google Identity Services Configuration
# ==============================================================================
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

# ==============================================================================
# OTP Security & Rate Limiting Configuration
# ==============================================================================
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ==============================================================================
# SMS Gateway Configuration
# ==============================================================================
# For Indian mobile numbers (Fast2SMS): https://www.fast2sms.com
FAST2SMS_API_KEY=

# For Global SMS (Twilio): https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==============================================================================
# Email Gateway Configuration
# ==============================================================================
# Option A: Gmail SMTP with 16-character App Password (https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option B: Standard Custom SMTP (Resend, SendGrid, Amazon SES, Mailgun, Postmark)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=login@restaurantflow.com
