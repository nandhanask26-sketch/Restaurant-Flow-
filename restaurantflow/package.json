{
  "name": "restaurantflow-monorepo",
  "version": "1.0.0",
  "description": "RestaurantFlow - Smart Restaurant Ordering & Management Platform",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
